#: src/components/guide-modal.js:138
msgid "Timeline Range Offsets"
msgstr ""

#: build/tzm-block-scroll-animations.js:1
#: src/components/guide-modal.js:141
msgid "You can refine the Timeline range using Range offsets applied to its top and bottom edges. Positive values move the boundary downward, negative values move it upward."
